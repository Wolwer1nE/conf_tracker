<% if conference.errors.any? %>
  <div class="mb-4 rounded-xl border border-rosepastel-300 bg-rosepastel-100 p-4 text-rosepastel-500">
    <p class="font-semibold"><%= pluralize(conference.errors.count, "error") %> prevented this conference from being saved:</p>
    <ul class="mt-2 list-disc pl-5">
      <% conference.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: conference, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :name, class: "text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, required: true, class: "input" %>
  </div>

  <div>
    <%= form.label :location, class: "text-sm font-medium text-slate-700" %>
    <%= form.text_field :location, required: true, class: "input" %>
  </div>

  <div>
    <%= form.label :starts_on, "Start date", class: "text-sm font-medium text-slate-700" %>
    <%= form.date_field :starts_on, required: true, class: "input" %>
  </div>

  <div>
    <%= form.label :ends_on, "End date", class: "text-sm font-medium text-slate-700" %>
    <%= form.date_field :ends_on, required: true, class: "input" %>
  </div>

  <div>
    <%= form.label :website_url, "Website URL", class: "text-sm font-medium text-slate-700" %>
    <%= form.url_field :website_url, placeholder: "https://example.org", class: "input" %>
  </div>

  <div>
    <%= form.label :description, class: "text-sm font-medium text-slate-700" %>
    <%= form.text_area :description, rows: 6, class: "input" %>
  </div>

  <div class="pt-2">
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
